# Preimenuj ovaj fajl u  .env  i popuni prave vrednosti.
# Fajl .env se NIKADA ne salje na GitHub (nalazi se u .gitignore).

# Port na kome radi server
PORT=5000

# Konekcioni string ka MongoDB bazi.
# Lokalna baza:
MONGO_URI=mongodb://127.0.0.1:27017/patike
# Ili MongoDB Atlas (oblak), primer:
# MONGO_URI=mongodb+srv://korisnik:lozinka@cluster0.xxxxx.mongodb.net/patike

# Tajni kljuc za potpisivanje JWT tokena - izmisli dugacak nasumican string
JWT_SECRET=promeni_me_u_dugacak_nasumican_string_123456789
